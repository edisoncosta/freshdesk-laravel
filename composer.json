{
    "name": "keepcloud/freshdesk-laravel",
    "description": "Laravel package for the Freshdesk API (v2)",
    "homepage": "https://github.com/edisoncosta/freshdesk-laravel",
    "keywords": ["freshdesk", "customer service", "support", "help desk", "api", "laravel"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthew Clarkson",
            "email": "mpclarkson@hilenium.com",
            "homepage": "http://mpclarkson.github.io/"
        },
        {
            "name": "Edison Costa",
            "email": "edison@keepcloud.io",
            "homepage": "https://keepcloud.io/"
        }
    ],
    "require": {
        "php": "^8.2",
        "keepcloud/freshdesk-php-sdk": "^2.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Keepcloud\\Laravel\\Freshdesk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Keepcloud\\Laravel\\Freshdesk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Keepcloud\\Laravel\\Freshdesk\\FreshdeskServiceProvider"
            ],
            "aliases": {
                "Freshdesk": "Keepcloud\\Laravel\\Freshdesk\\FreshdeskFacade"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
